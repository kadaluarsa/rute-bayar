RUTE_BAYAR_ENV=sandbox
RUTE_BAYAR_DB_PATH=./rute-bayar.sqlite3
RUTE_BAYAR_WEBHOOK_ADDR=:8080

# --- API keys (each >= 24 chars, all different) ---------------------------
# Admin/operator key: provider accounts, refunds, forwarding, outbox.
RUTE_BAYAR_API_KEY=
# AI agents (hosted LangGraph agent, MCP clients): quote, token, health.
RUTE_BAYAR_AGENT_API_KEY=
# Wishpull Temporal worker only: the one key that can execute a charge.
RUTE_BAYAR_EXECUTOR_API_KEY=

# --- Wishpull routing plane (PRD/TRD v0.3) --------------------------------
# Disable direct POST /api/v1/payments; every charge needs token + mandate.
RUTE_BAYAR_REQUIRE_MANDATE=true
# HMAC keys for routing tokens, "kid:base64(>=32 bytes)". First is active;
# keep the previous kid listed during rotation. openssl rand -base64 32
RUTE_BAYAR_ROUTING_TOKEN_KEYS=
RUTE_BAYAR_ROUTING_TOKEN_TTL=15m
# Optional JSON overlay for rules and contracted MDRs.
RUTE_BAYAR_ROUTING_CONFIG=./deploy/config/routing.example.json

# Public base URL of this instance; iPaymu gets <url>/webhooks/ipaymu as
# its per-payment notifyUrl when the caller sends none.
RUTE_BAYAR_PUBLIC_URL=

# --- Signed payment events to Wishpull (outbox) ---------------------------
RUTE_BAYAR_WISHPULL_EVENTS_URL=
RUTE_BAYAR_WISHPULL_EVENTS_SECRET=

# --- Ops ------------------------------------------------------------------
# When set, /metrics requires "Authorization: Bearer <token>".
RUTE_BAYAR_METRICS_TOKEN=
RUTE_BAYAR_SHUTDOWN_GRACE=20s

# --- Gateway credentials from Secret Manager (optional) -------------------
# Overrides the SQLite provider_accounts row for that provider/environment.
# RUTE_BAYAR_ACCOUNT_MIDTRANS_PRODUCTION_CREDENTIAL_JSON={"server_key":"...","client_key":"...","merchant_id":"..."}
# RUTE_BAYAR_ACCOUNT_XENDIT_PRODUCTION_CREDENTIAL_JSON={"secret_key":"..."}
# RUTE_BAYAR_ACCOUNT_XENDIT_PRODUCTION_CONFIG_JSON={"webhook_token":"..."}
# RUTE_BAYAR_ACCOUNT_DOKU_PRODUCTION_CREDENTIAL_JSON={"client_id":"...","secret_key":"..."}
# RUTE_BAYAR_ACCOUNT_IPAYMU_PRODUCTION_CREDENTIAL_JSON={"va":"...","api_key":"..."}
